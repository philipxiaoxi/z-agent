# App
APP_NAME=极同学
APP_ENV=development
APP_DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# DeepSeek (可选，Agno 也会自动读此环境变量)
DEEPSEEK_API_KEY=sk-your-key-here

# MCP 配置文件路径 (可选，默认 backend/mcp_servers.yaml)
MCP_SERVERS_CONFIG=

# Dify（可选；配置路径相对 backend 工作目录）
# 启用时：DIFY_WORKFLOWS_CONFIG=dify_workflows.yaml
DIFY_WORKFLOWS_CONFIG=
# 与 dify_workflows.yaml 中 ${...} 对应；新增 workflow 时在 yaml 与此处各加一项
DIFY_IMAGE_ANALYSIS_API_KEY=

# Docker Sandbox
SANDBOX_IMAGE=ghcr.io/agent-infra/sandbox:latest
SANDBOX_API_KEY=
SANDBOX_HOST_PORT_RANGE=18080-18090
